#!/usr/bin/env bash
# コミット前に個人情報の混入を検査する(コミットを中止する)。
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
fail=0

# 期限切れの kit_filled.md を削除しておく
[ -x "$root/scripts/cleanup_private.sh" ] && "$root/scripts/cleanup_private.sh" --stale >/dev/null 2>&1 || true

# 1) private/ 配下のファイルがステージされていないか(見本 *.example.md は除く)
bad="$(git diff --cached --name-only | grep -E '^private/' | grep -vE '^private/[^/]*\.example\.md$' || true)"
if [ -n "$bad" ]; then
  echo "中止: private/ のファイルがステージされています:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  echo "  取り消し: git restore --staged <ファイル>" >&2
  fail=1
fi

# 2) owner_info.md の実値が、ステージされた追加行に含まれていないか
#    (文字コードの影響を避けるため python3 で処理する)
info="$root/private/owner_info.md"
if [ -f "$info" ]; then
  if ! git diff --cached -U0 --no-color | python3 -I -c '
import re, sys
info, added, bad = sys.argv[1], [], []
for l in sys.stdin.read().splitlines():
    if l.startswith("+") and not l.startswith("+++"):
        added.append(l[1:])
text = "\n".join(added)
for line in open(info, encoding="utf-8").read().splitlines():
    m = re.match(r"^- ([^:：]+)[:：]\s*(.+)$", line)
    if m and len(m.group(2).strip()) >= 2 and m.group(2).strip() in text:
        bad.append(m.group(1).strip())
for k in bad:
    sys.stderr.write("中止: 個人情報(キー: %s)の値が、コミット対象に含まれています。{{%s}} に置き換えてください。\n" % (k, k))
sys.exit(1 if bad else 0)
' "$info"; then
    fail=1
  fi
fi

exit "$fail"
